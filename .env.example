# Session Scribe Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Required: Path to your Obsidian campaign vault
SCRIBE_VAULT_PATH=/path/to/your/obsidian/campaign/vault

# LLM Provider: "kimi" (default, uses Kimi Code CLI) or "nanogpt" (uses nano-gpt.com API)
SCRIBE_LLM_PROVIDER=kimi

# --- Kimi CLI settings (when llm_provider=kimi) ---
# Optional: Override Kimi's default model (leave empty to use kimi's config default)
# SCRIBE_KIMI_MODEL=

# --- nano-gpt.com settings (when llm_provider=nanogpt) ---
# Required when using nanogpt: Your nano-gpt.com API key
# SCRIBE_NANOGPT_API_KEY=your-nanogpt-api-key-here
# SCRIBE_NANOGPT_MODEL=chatgpt-4o-latest

# Optional: LM Studio URL for local embeddings (default: http://localhost:1234/v1)
SCRIBE_LM_STUDIO_BASE_URL=http://localhost:1234/v1

# Optional: Embedding model name (default: text-embedding-nomic-embed-text-v1.5)
SCRIBE_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5

# Optional: Log level (default: INFO)
SCRIBE_LOG_LEVEL=INFO
