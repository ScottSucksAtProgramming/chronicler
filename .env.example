# Chronicler Configuration
# Reference only for `CHRONICLER_` environment variable names.
# Recommended setup path: run `chronicler config init` to create config.toml.

# Required: Path to your Obsidian campaign vault
CHRONICLER_VAULT_PATH=/path/to/your/obsidian/campaign/vault

# Required: The vault name as it appears in Obsidian's CLI integration
CHRONICLER_VAULT_NAME=My Campaign Vault

# LLM Provider: "kimi" (default, uses Kimi Code CLI) or "nanogpt" (uses nano-gpt.com API)
CHRONICLER_LLM_PROVIDER=kimi

# --- Kimi CLI settings (when llm_provider=kimi) ---
# Optional: Override Kimi's default model (leave empty to use kimi's config default)
# CHRONICLER_KIMI_MODEL=

# --- nano-gpt.com settings (when llm_provider=nanogpt) ---
# Required when using nanogpt: Your nano-gpt.com API key
# CHRONICLER_NANOGPT_API_KEY=your-nanogpt-api-key-here
# CHRONICLER_NANOGPT_MODEL=chatgpt-4o-latest

# Optional: LM Studio URL for local embeddings (default: http://localhost:1234/v1)
CHRONICLER_LM_STUDIO_BASE_URL=http://localhost:1234/v1

# Optional: Embedding model name (default: text-embedding-nomic-embed-text-v1.5)
CHRONICLER_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5

# Optional: Log level (default: INFO)
CHRONICLER_LOG_LEVEL=INFO
